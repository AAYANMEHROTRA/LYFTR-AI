# Add two Gemini API keys from Google AI Studio. Never commit the real .env file.
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Be accurate and clear.
# For local Docker, keep this URL. For deployment, replace with your public backend URL before building frontend.
VITE_API_BASE_URL=http://localhost:8000
